{
  "name": "routerly",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "description": "Self-hosted API gateway for LLMs with intelligent routing, cost tracking and multi-provider support",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/service && npm run build --workspace=packages/cli && npm run build --workspace=packages/dashboard",
    "dev": "npm run dev --workspace=packages/service",
    "test": "npm test --workspaces --if-present && vitest run",
    "test:e2e": "vitest run",
    "lint": "eslint packages/*/src --ext .ts",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-module-versions.mjs",
    "release": "npm run build && changeset tag",
    "prepare": "husky",
    "docs:cut": "node scripts/docs-version.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:affected": "node scripts/screenshots-affected.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.8",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "playwright": "^1.48.0",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
