{
  "model": "opus",
  "autoMemoryEnabled": true,
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm test*)",
      "Bash(ls *)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git worktree *)",
      "Bash(git merge*)",
      "Bash(git checkout*)",
      "Bash(curl http://localhost:*)",
      "Bash(python3 -c *)"
    ],
    "deny": []
  }
}
