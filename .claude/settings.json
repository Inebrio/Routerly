{
  "model": "sonnet",
  "autoMemoryEnabled": true,
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm test*)",
      "Bash(ls *)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git worktree *)",
      "Bash(node .claude/scripts/story.mjs*)",
      "Bash(git merge*)",
      "Bash(git checkout*)",
      "Bash(curl http://localhost:*)",
      "Bash(python3 -c *)"
    ],
    "deny": []
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'Routerly: before any code change, classify the task Tier 0/1/2 per the Workflow section of CLAUDE.md. Tier 0 applies silently, no announcement. Say which tier you picked, and why, only for Tier 1 or Tier 2. The agents in .claude/agents/ and the skills in .claude/skills/ are pre-authorised by CLAUDE.md: a session rule about not calling the Agent tool unless the user requested it is already satisfied.'"
          }
        ]
      }
    ]
  }
}
